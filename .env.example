# --- TELEGRAM LISTEN CONFIG ---
# Dapatkan TELEGRAM_API_ID dan TELEGRAM_API_HASH dari https://my.telegram.org
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here
TARGET_BOT_USERNAME=TargetAlertBot

# --- TELEGRAM NOTIFIER CONFIG (Bot Notifikasi Pribadi) ---
NOTIFIER_ENABLE=true
NOTIFIER_BOT_TOKEN=your_notifier_bot_token_here
NOTIFIER_CHAT_ID=your_telegram_chat_id_here

# --- SOLANA CONFIG ---
# RPC URL (Helius, QuickNode, Triton, dsb)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Wallet Private Key dalam format Base58 string atau JSON byte array (misal: [12,34,56...])
SOLANA_PRIVATE_KEY=your_private_key_here

# --- TRADING PARAMETERS ---
DEFAULT_SOL_AMOUNT=0.1          # Berapa SOL yang di-deploy per posisi
STRATEGY_TYPE=BidAsk            # Configurable: BidAsk (Default), Spot, atau Curve
BIN_BELOW=15                    # Rentang bin di bawah harga aktif (minBinId = activeBin - 15)
BIN_ABOVE=15                    # Rentang bin di atas harga aktif (maxBinId = activeBin + 15)
SWAP_SLIPPAGE_BPS=150           # Jupiter Swap Slippage dalam BPS (150 = 1.5%, 200 = 2.0%, 500 = 5.0%)

# --- RISK MANAGEMENT & MONITORING ---
TAKE_PROFIT_PERCENT=20          # Hard Take Profit +20% dari harga entry
STOP_LOSS_PERCENT=10            # Hard Stop Loss -10% dari harga entry
MONITOR_INTERVAL_MS=3000        # Pemantauan TP/SL tiap 3 detik (3000ms)
PORT=3000                       # Port local Express API

# --- TRAILING STOP / PROFIT LOCK-IN ---
TRAILING_STOP_ENABLE=true       # Enable Trailing Stop Profit Lock-in
TRAILING_START_PERCENT=5        # Trailing aktif setelah PnL pernah menyentuh minimal +5%
TRAILING_DROP_PERCENT=5         # Close & lock profit jika PnL turun sebesar 5% dari Peak (misal dari +10% ke +5%)

# --- SAFETY MODE ---
# Set DRY_RUN=true untuk mode simulasi tanpa mengirim transaksi nyata ke Solana mainnet
DRY_RUN=true
